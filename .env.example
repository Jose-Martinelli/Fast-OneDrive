# Variáveis opcionais do Fast-OneDrive.
# Não são obrigatórias para correr: a maior parte da configuração vive em
# ~/.config/fast-onedrive/ (config.toml, rclone.conf, sync-control.json).
# Copiar para .env só se a sua sessão/systemd as exportar; o CLI não carrega .env sozinho.

# Caminho do binário CLI (KIO / plugins do Dolphin). Por omissão: ~/.local/bin/fastonedrive
# FASTONEDRIVE_BIN=

# 1 = desliga avisos Graph em tempo real (socket.io); fica só o poll do delta
# FASTONEDRIVE_NO_PUSH=1

# 1 = suprime logInfo (erros continuam a gravar-se)
# FASTONEDRIVE_QUIET=1

# Abre as Definições no separador rclone (uso interno da UI)
# FASTONEDRIVE_UI_TAB=rclone

# Internas (definidas pelo próprio processo; não configurar à mão):
# FASTONEDRIVE_INDEXING=1
# FASTONEDRIVE_DELTA_ONLY=1

# libfuse alternativa (fusepy)
# FUSE_LIBRARY_PATH=

# systemd Type=notify (unidade do mount)
# NOTIFY_SOCKET=

# Pesquisa de plugins Qt/KF (install-kio / Definições)
# QT_PLUGIN_PATH=
