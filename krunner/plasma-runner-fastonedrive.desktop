[Desktop Entry]
Name=Fast-OneDrive
Comment=Busca arquivos no índice OneDrive (sem FUSE)
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=cloud-download
X-KDE-PluginInfo-Author=Fast-OneDrive
X-KDE-PluginInfo-Name=fastonedrive
X-KDE-PluginInfo-Version=0.1.0
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.fastonedrive.krunner
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=3
X-Plasma-Runner-Unique-Results=true
X-Plasma-Runner-Syntaxes=:q:
X-Plasma-Runner-Syntax-Descriptions=Busca nomes no índice OneDrive por :q:
