[Unit]
Description=Fast-OneDrive — sincronizar só ficheiros pinados (nuvem ↔ pinned/)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/fastonedrive sync-pins --notify
# Sem --path: sincroniza cada perfil à parte; a falha de uma conta não pára as outras.
# Desenvolvimento: %h/.local/bin/fastonedrive sync-pins --notify
# Nunca apontar rclone RC para 127.0.0.1:5572 (mount).
# Nunca rclone sync da raiz onedrive:.

[Install]
WantedBy=default.target
